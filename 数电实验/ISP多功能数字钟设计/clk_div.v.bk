module clk_div #(
    // 参数化设计，方便仿真与实际下板切换
    // 默认按照 100MHz 输入时钟计算
    parameter CNT_1K_MAX  = 17'd49_999,       // 100M / 1k / 2 - 1 = 49,999
    parameter CNT_5H_MAX  = 17'd99_999,       // 100M / 500 / 2 - 1 = 99,999
    parameter CNT_1HZ_MAX = 26'd49_999_999    // 100M / 1 / 2 - 1 = 49,999,999 (仿真时可改为49_999来产生1kHz代替1Hz)
)(
    input clk_100m,
    output reg clk_1k,
    output reg clk_5h,
    output reg clk_1hz,
    input cr
);

    reg [16:0] cnt_1k;
    reg [16:0] cnt_5h;
    reg [25:0] cnt_1hz;

    // 产生 1kHz 时钟 (用于动态扫描)
    always @(posedge clk_100m or negedge cr) begin
        if (!cr) begin
            cnt_1k <= 17'd0;
            clk_1k <= 1'b0;
        end else if (cnt_1k == CNT_1K_MAX) begin
            cnt_1k <= 17'd0;
            clk_1k <= ~clk_1k;
        end else begin
            cnt_1k <= cnt_1k + 1'b1;
        end
    end

    // 产生 500Hz 时钟 (用于闹钟铃声)
    always @(posedge clk_100m or negedge cr) begin
        if (!cr) begin
            cnt_5h <= 17'd0;
            clk_5h <= 1'b0;
        end else if (cnt_5h == CNT_5H_MAX) begin
            cnt_5h <= 17'd0;
            clk_5h <= ~clk_5h;
        end else begin
            cnt_5h <= cnt_5h + 1'b1;
        end
    end

    // 产生 1Hz 时钟 (用于系统计时)
    always @(posedge clk_100m or negedge cr) begin
        if (!cr) begin
            cnt_1hz <= 26'd0;
            clk_1hz <= 1'b0;
        end else if (cnt_1hz == CNT_1HZ_MAX) begin
            cnt_1hz <= 26'd0;
            clk_1hz <= ~clk_1hz;
        end else begin
            cnt_1hz <= cnt_1hz + 1'b1;
        end
    end

endmodule