<!-- launch/ring_detector.launch -->
<launch>
    <node name="ring_detector" pkg="ring_detector" type="ring_detector_node" output="screen">
        <rosparam file="$(find ring_detector)/config/ring_detector.yaml" command="load"/>
        
        <!-- 可以在这里覆盖参数 -->
        <!--
        <param name="voxel_leaf_size" value="0.01"/>
        <param name="radius_min" value="0.1"/>
        <param name="radius_max" value="0.3"/>
        -->
    </node>
</launch>
