<launch>
    <!-- 平面提取器 -->
    <node name="plane_extractor" pkg="ring_detector" type="plane_extractor_node" output="screen">
        <rosparam file="$(find ring_detector)/config/plane_extractor.yaml" command="load"/>
        <param name="input_map_topic" value="/map_accumulator/accumulated_map"/>
        <param name="output_plane_topic" value="/plane_extractor/plane_map"/>
    </node>
</launch>
